# ===== PKI Application Environment Configuration =====
#
# AUTHORITATIVE SOURCE: This file documents all supported environment variables.
#
# Usage:
# - Host deployment: copy to .env and configure values for your environment
# - Docker deployment: copy to docker/.env OR use docker-compose.yml environment overrides
#   * docker/docker-compose.yml hardcodes certain values (PKI_HOST, PKI_PORT, PKI_DATA_DIR, PKI_DB_PATH)
#   * Other values can be set in docker/.env OR docker-compose.yml environment section
#   * If both are set, docker-compose.yml takes precedence
#
# Key differences:
# - Host: paths are relative or absolute to your filesystem
# - Docker: paths MUST match container paths (/app/data, /app/database) managed by volume mounts
# - Docker: PKI_HOST MUST be 0.0.0.0 (for network access within container networking)
# - Docker (dev): PKI_COOKIE_SECURE should be false (HTTP to localhost:8000)
# - Docker (prod): PKI_COOKIE_SECURE should be true (HTTPS via reverse proxy)
#
# ===== Server Configuration =====

# Server bind address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
# Host deployment: can use 127.0.0.1 for localhost-only access or 0.0.0.0 for network access
# Docker deployment: MUST be 0.0.0.0 (hardcoded in docker-compose.yml)
# Default: 0.0.0.0
PKI_HOST=127.0.0.1

# Server port (must match the port exposed in docker-compose.yml)
# Host deployment: can use any available port
# Docker deployment: must be 8000 (matches exposed port in docker-compose.yml)
# Default: 8000
PKI_PORT=8000

# PKI web app base URL used when building CRL Distribution Point URLs in issued certs.
# Host deployment: set to http(s)://your-hostname:port or the actual domain
# Docker deployment: use http://localhost:8000 for local development, https://your-domain for production
# IMPORTANT: This URL is baked into issued certificates, so it must be reachable by clients
# Default: http://localhost:8000
PKI_BASE_URL=http://localhost:8000

# Recreate invalid database file from schema at startup (true/false).
# WARNING: true will replace an invalid DB file and keep a *.invalid.bak backup.
PKI_DB_AUTO_REINIT=false

# Absolute path to PKI data root directory (org folders, cert artifacts).
# Host deployment: leave empty for <repo>/data, or set to absolute path (Windows: C:\pki\data, Linux: /var/lib/pki/data)
# Docker deployment: MUST be /app/data (hardcoded in Dockerfile, managed by docker volume 'pki_data')
#                    Do NOT override - the volume mount in docker-compose.yml handles persistence
# Default: (empty = <repo>/data on host, /app/data in Docker)
PKI_DATA_DIR=

# Absolute path to SQLite database file.
# Host deployment: leave empty for <repo>/database/pki.db, or set to absolute path (Windows: C:\pki\database\pki.db, Linux: /var/lib/pki/database/pki.db)
# Docker deployment: MUST be /app/database/pki.db (hardcoded in Dockerfile, managed by docker volume 'pki_database')
#                    Do NOT override - the volume mount in docker-compose.yml handles persistence
# Default: (empty = <repo>/database/pki.db on host, /app/database/pki.db in Docker)
PKI_DB_PATH=

# ===== Certificate Generation =====

# Optional fixed passphrase for root CA key generation.
# If empty, a random password file is generated.
PKI_PASS=

# ===== Notifications =====

# Notification mode for scripts/notify_expiring.py
# Allowed: log | email | webhook
NOTIFY_METHOD=log

# SMTP settings (used when NOTIFY_METHOD=email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=admin@example.com,ops@example.com

# Webhook endpoint (used when NOTIFY_METHOD=webhook)
WEBHOOK_URL=

# Optional flag for consistency checker to enforce CA certs have empty password
# Used by: scripts/check_consistency.py
# Default: false
PKI_ENFORCE_CA_EMPTY_PWD_PATH=false

# ===== Logging Configuration =====

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Controls verbosity of application logs
# Default: INFO
PKI_LOG_LEVEL=INFO

# ===== Subprocess Configuration =====

# Timeout for certificate generation operations (seconds).
# Certificates are generated via subprocess calls to openssl.
# Increase if your system is slow or generating large key sizes.
# Default: 120
PKI_SUBPROCESS_TIMEOUT_SECONDS=120

# ===== Encryption at Rest =====

# Strong password for encrypting all certificate artifacts at rest (*.pem.enc, *.key.enc, etc.)
# REQUIRED for production. Must be a strong, random password (32+ characters recommended).
# Host deployment: set in this file and load via .env
# Docker deployment: set in docker-compose.yml environment section OR in this .env (loaded via env_file)
#                    Both must use the SAME value for the same certificate store
# Generate with: openssl rand -base64 32
PKI_ENCRYPTION_KEY=your-strong-encryption-password-here

# Random salt for PBKDF2 key derivation.
# REQUIRED for production. Must be unique per installation and consistent across instances accessing the same store.
# IMPORTANT: Changing this after initial setup will make all encrypted artifacts inaccessible.
# Host deployment: set in this file and load via .env
# Docker deployment: set in docker-compose.yml environment section OR in this .env (loaded via env_file)
#                    Both must use the SAME value for the same certificate store
# Generate once with: openssl rand -base64 32
PKI_ENCRYPTION_SALT=your-random-base64-salt-here

# ===== Authentication (Session JWT with Role-Based Access Control) =====

# Three API keys, one per role: admin (full access), manager (end-entity cert creation), user (read-only)
# Each key must be unique and strong (32+ random characters recommended).
# Host deployment: set in this file and load via .env
# Docker deployment: set in docker-compose.yml environment section OR in this .env (loaded via env_file)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PKI_API_KEY_ADMIN=change-this-admin-api-key
PKI_API_KEY_MANAGER=change-this-manager-api-key
PKI_API_KEY_USER=change-this-user-api-key

# Secret used to sign/verify JWT sessions (HS256)
# Host deployment: set in this file and load via .env
# Docker deployment: set in docker-compose.yml environment section OR in this .env (loaded via env_file)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PKI_JWT_SECRET=change-this-jwt-secret

# Session duration in minutes (default: 15)
PKI_SESSION_MINUTES=15

# Cookie name that stores the JWT session in the browser.
# Change only if you need to avoid conflicts with another app on same host/domain.
PKI_AUTH_COOKIE_NAME=pki_session

# Cookie security flag - controls whether cookie is sent only over HTTPS
# Host development: set to false to allow HTTP development
# Host production: set to true (HTTPS only)
# Docker development: set to false (local http://localhost:8000 in docker-compose.yml)
# Docker production: set to true (HTTPS only, requires valid HTTPS reverse proxy)
# Default: true (HTTPS only) - CHANGE to false for local development
PKI_COOKIE_SECURE=false

# SameSite policy for CSRF/cross-site behavior:
# - lax: recommended default for normal navigation/forms
# - strict: strongest, but can break some flows
# - none: needed for cross-site use (requires PKI_COOKIE_SECURE=true)
PKI_COOKIE_SAMESITE=lax

# Optional domain scope for the cookie (empty = host-only cookie).
# Example: .example.com to share session across subdomains.
PKI_COOKIE_DOMAIN=
